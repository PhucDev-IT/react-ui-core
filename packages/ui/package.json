{
  "name": "@sarae/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/theme/index.scss"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "jsbarcode": "^3.12.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^8.3.0",
    "sass": "^1.90.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6"
  },
  "scripts": {
    "build": "pnpm run typecheck && vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
